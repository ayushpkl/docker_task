pipeline {
    agent any

    environment {
        IMAGE_NAME = "my-node-site"
        CONTAINER_NAME = "my-site-container"
        APP_URL = "http://localhost:3000"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${IMAGE_NAME} -f Documents/docker-git-task/Dockerfile ."
                }
            }
        }

        stage('Deploy Container') {
            steps {
                script {
                    sh "docker stop ${CONTAINER_NAME} || true"
                    sh "docker rm ${CONTAINER_NAME} || true"
                    sh "docker run -d -p 3000:3000 --name ${CONTAINER_NAME} ${IMAGE_NAME}"
                }
            }
        }

        stage('Open Application Locally') {
            steps {
                script {
                    sleep 2
                    sh '''
                        export DISPLAY=:0
                        export XAUTHORITY=/home/ayush.ranjan/.Xauthority
                        nohup google-chrome http://localhost:3000 >/dev/null 2>&1 &
                    '''
                }
            }
        }
    }
}
